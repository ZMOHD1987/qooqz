<?php
declare(strict_types=1);

/**
 * htdocs/api/shared/helpers/RBAC.php
 * 
 * Ultimate Production-Ready RBAC System
 * Updated to support current database schema with tenant_id in all tables
 * Supports resource_permissions for granular access control
 */

final class RBAC
{
    private ?PDO $pdo = null;
    private ?Redis $redis = null;
    private int $tenantId = 1;
    private array $config = [];

    // Constants
    private const CACHE_PREFIX = 'rbac:';
    private const CACHE_TTL = 1800; // 30 minutes
    private const MAX_BULK_SIZE = 100;
    private const HEALTH_CHECK_KEY = 'rbac:health';

    // Configuration keys
    private const CONFIG_KEYS = [
        'redis_enabled' => true,
        'cache_ttl' => self::CACHE_TTL,
        'audit_enabled' => true,
        'rate_limit_enabled' => true,
        'async_enabled' => false,
        'max_bulk_size' => self::MAX_BULK_SIZE,
        'resource_permissions_enabled' => false, // Enable for granular control
    ];

    public function __construct(?PDO $pdo = null, ?Redis $redis = null, int $tenantId = 1)
    {
        $this->pdo = $pdo ?? $this->resolvePdoConnection();
        $this->redis = $redis ?? $this->resolveRedisConnection();
        $this->tenantId = $tenantId;
        $this->config = $this->loadConfiguration();
        
        $this->ensureSession();
    }

    private function loadConfiguration(): array
    {
        $config = self::CONFIG_KEYS;
        
        // Load from .env if available
        foreach ($config as $key => $default) {
            $envKey = 'RBAC_' . strtoupper($key);
            $envValue = getenv($envKey) ?: ($_ENV[$envKey] ?? null);
            
            if ($envValue !== null) {
                $config[$key] = filter_var($envValue, FILTER_VALIDATE_BOOLEAN, FILTER_NULL_ON_FAILURE) ?? $envValue;
            }
        }
        
        return $config;
    }

    private function resolvePdoConnection(): ?PDO
    {
        // Priority: Global > Container > DatabaseConnection > Null
        if (!empty($GLOBALS['ADMIN_DB']) && $GLOBALS['ADMIN_DB'] instanceof PDO) {
            return $GLOBALS['ADMIN_DB'];
        }

        if (!empty($GLOBALS['CONTAINER']['pdo']) && $GLOBALS['CONTAINER']['pdo'] instanceof PDO) {
            return $GLOBALS['CONTAINER']['pdo'];
        }

        if (class_exists('DatabaseConnection', false)) {
            try {
                return DatabaseConnection::getConnection();
            } catch (Throwable $e) {
                $this->logError('Database connection failed', ['error' => $e->getMessage()]);
            }
        }

        return null;
    }

    private function resolveRedisConnection(): ?Redis
    {
        if (!class_exists('RedisHelper', false)) {
            return null;
        }
        
        try {
            return RedisHelper::instance();
        } catch (Throwable $e) {
            $this->logError('Redis connection failed', ['error' => $e->getMessage()]);
            return null;
        }
    }

    private function ensureSession(): void
    {
        if (session_status() === PHP_SESSION_NONE && php_sapi_name() !== 'cli') {
            @session_start([
                'cookie_httponly' => true,
                'cookie_secure' => (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off'),
                'cookie_samesite' => 'Lax',
            ]);
        }
    }

    private function getCacheKey(string $type, int $userId): string
    {
        return self::CACHE_PREFIX . "{$this->tenantId}:{$type}:{$userId}";
    }

    private function getFromCache(string $key): mixed
    {
        if (!$this->config['redis_enabled'] || !$this->redis) {
            return null;
        }
        
        try {
            $data = $this->redis->get($key);
            return $data ? json_decode($data, true) : null;
        } catch (Throwable $e) {
            $this->logError('Cache read failed', ['key' => $key, 'error' => $e->getMessage()]);
            return null;
        }
    }

    private function setCache(string $key, mixed $data, ?int $ttl = null): bool
    {
        if (!$this->config['redis_enabled'] || !$this->redis) {
            return false;
        }
        
        $ttl = $ttl ?? $this->config['cache_ttl'];
        
        try {
            return $this->redis->setex($key, $ttl, json_encode($data));
        } catch (Throwable $e) {
            $this->logError('Cache write failed', ['key' => $key, 'error' => $e->getMessage()]);
            return false;
        }
    }

    private function invalidateCache(string $pattern): void
    {
        if (!$this->config['redis_enabled'] || !$this->redis) {
            return;
        }
        
        try {
            $keys = $this->redis->keys(self::CACHE_PREFIX . $pattern);
            if (!empty($keys)) {
                $this->redis->del($keys);
            }
        } catch (Throwable $e) {
            $this->logError('Cache invalidation failed', ['pattern' => $pattern, 'error' => $e->getMessage()]);
        }
    }

    private function logAudit(string $action, array $data): void
{
    if (!$this->config['audit_enabled']) {
        return;
    }
    
    $auditData = [
        'timestamp' => date('c'),
        'tenant_id' => $this->tenantId,
        'entity_type' => $data['entity_type'] ?? 'user', // Default to user
        'entity_id' => $data['entity_id'] ?? $data['user_id'] ?? null,
        'action' => $action,
        'data' => $data,
        'ip' => $_SERVER['REMOTE_ADDR'] ?? 'unknown',
        'user_agent' => $_SERVER['HTTP_USER_AGENT'] ?? 'unknown',
    ];
    
    // Log to database
    if ($this->pdo) {
        try {
            $stmt = $this->pdo->prepare("
                INSERT INTO audit_logs (tenant_id, entity_type, entity_id, user_id, action, ip_address, user_agent, payload)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?)
            ");
            $stmt->execute([
                $this->tenantId,
                $auditData['entity_type'],
                $auditData['entity_id'],
                $data['user_id'] ?? null,
                $action,
                $auditData['ip'],
                substr($auditData['user_agent'], 0, 255),
                json_encode($auditData)
            ]);
        } catch (Throwable $e) {
            // Fallback without tenant_id/entity fields
            try {
                $stmt = $this->pdo->prepare("
                    INSERT INTO audit_logs (user_id, action, ip_address, user_agent, payload)
                    VALUES (?, ?, ?, ?, ?)
                ");
                $stmt->execute([
                    $data['user_id'] ?? null,
                    $action,
                    $auditData['ip'],
                    substr($auditData['user_agent'], 0, 255),
                    json_encode($auditData)
                ]);
            } catch (Throwable $e2) {
                // Silent fail
                $this->logError('Audit log failed completely', [
                    'original_error' => $e->getMessage(),
                    'fallback_error' => $e2->getMessage()
                ]);
            }
        }
    }
    
    // Log to file
    safe_log('audit', $action, $auditData);
}

    private function logError(string $message, array $context = []): void
    {
        $context['tenant_id'] = $this->tenantId;
        safe_log('error', 'RBAC: ' . $message, $context);
    }

    private function checkRateLimit(int $userId, string $action): bool
    {
        if (!$this->config['rate_limit_enabled']) {
            return true;
        }
        
        $key = "ratelimit:rbac:{$this->tenantId}:{$userId}:{$action}";
        
        try {
            $current = $this->redis ? $this->redis->incr($key) : 1;
            
            if ($this->redis && $current === 1) {
                $this->redis->expire($key, 60); // 1 minute window
            }
            
            // Allow max 100 actions per minute
            return $current <= 100;
        } catch (Throwable $e) {
            return true; // Allow on error
        }
    }

    // ===== CORE METHODS =====

    public function getUserRoles(int $userId): array
    {
        if (!$this->checkRateLimit($userId, 'get_roles')) {
            $this->logError('Rate limit exceeded', ['user_id' => $userId, 'action' => 'get_roles']);
            return [];
        }

        $cacheKey = $this->getCacheKey('roles', $userId);
        $cached = $this->getFromCache($cacheKey);
        
        if ($cached !== null) {
            return $cached;
        }

        $roles = $this->fetchRolesFromDb($userId);
        $this->setCache($cacheKey, $roles);
        
        $this->logAudit('roles_loaded', ['user_id' => $userId, 'count' => count($roles)]);
        
        return $roles;
    }

    public function getUserPermissions(int $userId): array
    {
        if (!$this->checkRateLimit($userId, 'get_permissions')) {
            $this->logError('Rate limit exceeded', ['user_id' => $userId, 'action' => 'get_permissions']);
            return [];
        }

        $cacheKey = $this->getCacheKey('permissions', $userId);
        $cached = $this->getFromCache($cacheKey);
        
        if ($cached !== null) {
            return $cached;
        }

        $permissions = $this->fetchPermissionsFromDb($userId);
        $this->setCache($cacheKey, $permissions);
        
        $this->logAudit('permissions_loaded', ['user_id' => $userId, 'count' => count($permissions)]);
        
        return $permissions;
    }

    public function getUserResourcePermissions(int $userId, string $resourceType): array
    {
        if (!$this->config['resource_permissions_enabled']) {
            return [];
        }

        if (!$this->checkRateLimit($userId, 'get_resource_permissions')) {
            $this->logError('Rate limit exceeded', ['user_id' => $userId, 'action' => 'get_resource_permissions']);
            return [];
        }

        $cacheKey = $this->getCacheKey("resource_permissions:{$resourceType}", $userId);
        $cached = $this->getFromCache($cacheKey);
        
        if ($cached !== null) {
            return $cached;
        }

        $permissions = $this->fetchResourcePermissionsFromDb($userId, $resourceType);
        $this->setCache($cacheKey, $permissions);
        
        return $permissions;
    }

    public function reloadUserPermissions(int $userId): array
    {
        if (!$this->checkRateLimit($userId, 'reload_permissions')) {
            $this->logError('Rate limit exceeded', ['user_id' => $userId, 'action' => 'reload_permissions']);
            return [];
        }

        // Clear cache
        $this->invalidateCache("*:permissions:{$userId}");
        $this->invalidateCache("*:roles:{$userId}");
        $this->invalidateCache("*:resource_permissions:*:{$userId}");
        
        // Reload from DB
        $roles = $this->fetchRolesFromDb($userId);
        $permissions = $this->fetchPermissionsFromDb($userId);
        
        // Update session
        $this->ensureSession();
        $_SESSION['roles'] = $roles;
        $_SESSION['permissions'] = $permissions;
        
        // Cache new data
        $this->setCache($this->getCacheKey('roles', $userId), $roles);
        $this->setCache($this->getCacheKey('permissions', $userId), $permissions);
        
        $this->logAudit('permissions_reloaded', [
            'user_id' => $userId,
            'roles_count' => count($roles),
            'permissions_count' => count($permissions)
        ]);
        
        return $permissions;
    }

    private function fetchRolesFromDb(int $userId): array
    {
        if (!$this->pdo) {
            return [];
        }

        try {
            // Get role_id from tenant_users, then get role details from roles
            $stmt = $this->pdo->prepare("
                SELECT r.key_name 
                FROM tenant_users tu
                INNER JOIN roles r ON r.id = tu.role_id AND r.tenant_id = tu.tenant_id
                WHERE tu.user_id = ? AND tu.tenant_id = ? AND tu.is_active = 1
                LIMIT 1
            ");
            $stmt->execute([$userId, $this->tenantId]);
            $row = $stmt->fetch(PDO::FETCH_ASSOC);

            return $row ? [(string)$row['key_name']] : [];
        } catch (Throwable $e) {
            $this->logError('Roles fetch failed', [
                'user_id' => $userId,
                'tenant_id' => $this->tenantId,
                'error' => $e->getMessage()
            ]);
            return [];
        }
    }

    private function fetchPermissionsFromDb(int $userId): array
    {
        if (!$this->pdo) {
            return [];
        }

        try {
            // Get permissions through role_permissions
            $stmt = $this->pdo->prepare("
                SELECT DISTINCT p.key_name
                FROM tenant_users tu
                INNER JOIN role_permissions rp ON rp.role_id = tu.role_id AND rp.tenant_id = tu.tenant_id
                INNER JOIN permissions p ON p.id = rp.permission_id AND p.tenant_id = tu.tenant_id
                WHERE tu.user_id = ? AND tu.tenant_id = ? AND tu.is_active = 1
            ");
            $stmt->execute([$userId, $this->tenantId]);

            $permissions = [];
            while ($row = $stmt->fetch(PDO::FETCH_ASSOC)) {
                if (!empty($row['key_name'])) {
                    $permissions[] = (string)$row['key_name'];
                }
            }

            return array_values(array_unique($permissions));
        } catch (Throwable $e) {
            $this->logError('Permissions fetch failed', [
                'user_id' => $userId,
                'tenant_id' => $this->tenantId,
                'error' => $e->getMessage()
            ]);
            return [];
        }
    }

    private function fetchResourcePermissionsFromDb(int $userId, string $resourceType): array
    {
        if (!$this->pdo) {
            return [];
        }

        try {
            // Get resource permissions through role_permissions and resource_permissions
            $stmt = $this->pdo->prepare("
                SELECT rp.*
                FROM tenant_users tu
                INNER JOIN role_permissions rlp ON rlp.role_id = tu.role_id AND rlp.tenant_id = tu.tenant_id
                INNER JOIN resource_permissions rp ON rp.permission_id = rlp.permission_id
                WHERE tu.user_id = ? AND tu.tenant_id = ? AND tu.is_active = 1 
                AND rp.resource_type = ?
                LIMIT 1
            ");
            $stmt->execute([$userId, $this->tenantId, $resourceType]);
            $row = $stmt->fetch(PDO::FETCH_ASSOC);

            return $row ?: [];
        } catch (Throwable $e) {
            $this->logError('Resource permissions fetch failed', [
                'user_id' => $userId,
                'tenant_id' => $this->tenantId,
                'resource_type' => $resourceType,
                'error' => $e->getMessage()
            ]);
            return [];
        }
    }

    // ===== STATIC METHODS =====

    public static function getRoles(int $userId, int $tenantId = 1): array
    {
        return (new self(null, null, $tenantId))->getUserRoles($userId);
    }

    public static function getPermissions(int $userId, int $tenantId = 1): array
    {
        return (new self(null, null, $tenantId))->getUserPermissions($userId);
    }

    public static function getResourcePermissions(int $userId, string $resourceType, int $tenantId = 1): array
    {
        return (new self(null, null, $tenantId))->getUserResourcePermissions($userId, $resourceType);
    }

    public static function reload(int $userId, int $tenantId = 1): array
    {
        return (new self(null, null, $tenantId))->reloadUserPermissions($userId);
    }

    public static function hasPermission(string $permission, int $userId = null, int $tenantId = 1): bool
    {
        $userId = $userId ?? ($_SESSION['user']['id'] ?? 0);
        if (!$userId) return false;

        // Super admin bypass
        if (!empty($_SESSION['user']['role_id']) && (int)$_SESSION['user']['role_id'] === 1) {
            return true;
        }

        $permissions = $_SESSION['permissions'] ?? [];
        return in_array($permission, $permissions, true);
    }

    public static function hasResourcePermission(string $resourceType, string $action, int $userId = null, int $tenantId = 1): bool
    {
        $userId = $userId ?? ($_SESSION['user']['id'] ?? 0);
        if (!$userId) return false;

        $rbac = new self(null, null, $tenantId);
        $resourcePerms = $rbac->getUserResourcePermissions($userId, $resourceType);

        if (empty($resourcePerms)) {
            return false;
        }

        // Check specific action permission
        $actionMap = [
            'view_all' => 'can_view_all',
            'view_own' => 'can_view_own',
            'view_tenant' => 'can_view_tenant',
            'create' => 'can_create',
            'edit_all' => 'can_edit_all',
            'edit_own' => 'can_edit_own',
            'delete_all' => 'can_delete_all',
            'delete_own' => 'can_delete_own',
        ];

        return isset($actionMap[$action]) && !empty($resourcePerms[$actionMap[$action]]);
    }

    public static function reload_user_permissions_static(int $userId): void
    {
        $tenantId = $_SESSION['tenant_id'] ?? 1;
        (new self(null, null, $tenantId))->reloadUserPermissions($userId);
    }

    // ===== BULK OPERATIONS =====

    public function reloadBulkPermissions(array $userIds): array
    {
        if (count($userIds) > $this->config['max_bulk_size']) {
            throw new InvalidArgumentException('Bulk size exceeds limit');
        }

        $results = [];
        foreach ($userIds as $userId) {
            $results[$userId] = $this->reloadUserPermissions($userId);
        }

        $this->logAudit('bulk_permissions_reloaded', [
            'user_ids' => $userIds,
            'count' => count($userIds)
        ]);

        return $results;
    }

    // ===== ASYNC OPERATIONS =====

    public function reloadPermissionsAsync(int $userId): void
    {
        if (!$this->config['async_enabled'] || !class_exists('QueueManager', false)) {
            $this->reloadUserPermissions($userId);
            return;
        }

        QueueManager::push('rbac_reload', [
            'user_id' => $userId,
            'tenant_id' => $this->tenantId,
            'timestamp' => time()
        ]);
    }

    // ===== CACHE MANAGEMENT =====

    public function clearUserCache(int $userId): void
    {
        $this->invalidateCache("*:*:{$userId}");
        
        $this->ensureSession();
        unset($_SESSION['roles'], $_SESSION['permissions']);
        
        $this->logAudit('cache_cleared', ['user_id' => $userId]);
    }

    public function clearTenantCache(): void
    {
        $this->invalidateCache("{$this->tenantId}:*");
        $this->logAudit('tenant_cache_cleared', ['tenant_id' => $this->tenantId]);
    }

    public function clearAllCache(): void
    {
        if ($this->redis) {
            $this->redis->flushDB();
        }
        $this->logAudit('all_cache_cleared', []);
    }

    // ===== HEALTH CHECKS & METRICS =====

    public function healthCheck(): array
    {
        $checks = [
            'database' => $this->pdo !== null,
            'redis' => $this->redis !== null,
            'tenant_id' => $this->tenantId,
            'config_loaded' => !empty($this->config),
            'session_active' => session_status() === PHP_SESSION_ACTIVE,
        ];

        // Performance metrics
        $start = microtime(true);
        $testUser = 1;
        $this->getUserPermissions($testUser);
        $latency = round((microtime(true) - $start) * 1000, 2);

        $checks['performance_ms'] = $latency;
        $checks['healthy'] = $checks['database'] && $latency < 100; // < 100ms

        // Cache health check
        $healthKey = self::HEALTH_CHECK_KEY . ":{$this->tenantId}";
        $this->setCache($healthKey, ['status' => 'ok', 'timestamp' => time()], 60);
        $cached = $this->getFromCache($healthKey);
        $checks['cache_healthy'] = $cached !== null && $cached['status'] === 'ok';

        return $checks;
    }

    public function getMetrics(): array
    {
        return [
            'tenant_id' => $this->tenantId,
            'config' => $this->config,
            'connections' => [
                'database' => $this->pdo !== null,
                'redis' => $this->redis !== null,
            ],
            'cache_stats' => $this->getCacheStats(),
            'health' => $this->healthCheck(),
        ];
    }

    private function getCacheStats(): array
    {
        if (!$this->redis) {
            return ['enabled' => false];
        }

        try {
            $info = $this->redis->info('memory');
            return [
                'enabled' => true,
                'keys_count' => $this->redis->dbSize(),
                'memory_used' => $info['used_memory'] ?? 'unknown',
                'memory_peak' => $info['used_memory_peak'] ?? 'unknown',
            ];
        } catch (Throwable $e) {
            return ['enabled' => false, 'error' => $e->getMessage()];
        }
    }

    // ===== UTILITY METHODS =====

    public function setTenantId(int $tenantId): self
    {
        $this->tenantId = $tenantId;
        return $this;
    }

    public function getTenantId(): int
    {
        return $this->tenantId;
    }

    public static function createForTenant(int $tenantId): self
    {
        return new self(null, null, $tenantId);
    }
}